# Generated by `scaffold new portconfig`. Safe to edit: re-running will not
# overwrite this file. Change PORT_BASE if the block clashes with another checkout.
COMPOSE_PROJECT_NAME={{ .Scaffold.stack }}

PORT_BASE={{ .Computed.base }}
ADMIN_PORT={{ .Computed.admin }}
{{- range $i, $s := .Scaffold.services }}
{{ $s | upper }}_PORT={{ add $.Computed.base (add $i 1) }}
{{- end }}
